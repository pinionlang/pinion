//# case: list-helpers
//# expect: run
//# stdout: {"a": 3, "b": 2, "c": 1}
//# stdout: {1: ["a", "b", "c", "a", "b", "a"]}
//# stdout: ["a", "b"] ["b", "a"] ["a", "b", "c"]
//# stdout: a 3|b 2|c 1
//# stdout: "a" "c" 6
//# stdout: 2 None
//# stdout: [0, 1, 4, 9] 10
//# stdout: 007|ab..
data Count {
  pub word: Str
  pub n: Int
}

fn main() !io {
  let words = "a b c a b a".words()
  let counts = words.count_by(w => w)
  print(debug(counts))
  print(debug(words.group_by(w => w.len())))
  print("{debug(words.take(2))} {debug(words.drop(4))} {debug(words.distinct())}")
  let cs = counts.keys().map(w => Count(word: w, n: counts.get_or(w, 0)))
  print(cs.sort_by(c => (-c.n, c.word)).map(c => "{c.word} {c.n}").join("|"))
  let top = cs.max_by(c => c.n).map(c => c.word) ?? ""
  let low = cs.min_by(c => c.n).map(c => c.word) ?? ""
  print("{debug(top)} {debug(low)} {cs.sum_by(c => c.n)}")
  print("{debug(words.index_of("c"))} {debug(words.index_of("z"))}")
  print("{debug((0..4).map(i => i * i))} {(1..=4).sum()}")
  print("{"7".pad_left(3, "0")}|{"ab".pad_right(4, ".")}")
}

//# case: map-and-mut-helpers
//# expect: run
//# stdout: {"x": 20, "y": 10}
//# stdout: {"x": 2}
//# stdout: MutMap{"a": 2, "b": 1, "n": 7}
//# stdout: 1 MutList[100, 2, 4]
fn main() !io {
  let m = {"x": 2, "y": 1}
  print(debug(m.map_values(v => v * 10).filter((k, v) => v > 0)))
  print(debug(m.filter((k, v) => k == "x")))
  let tally = MutMap<Str, Int>()
  for w in ["a", "b", "a"] {
    tally.inc(w)
  }
  tally.update("n", 5, v => v + 1)
  tally.update("n", 5, v => v + 1)
  print(debug(tally))
  let xs = MutList<Int>()
  for i in 1..6 {
    xs.push(i)
  }
  let first = xs.remove_at(0)
  xs.insert(0, 100)
  xs.retain(x => x % 2 == 0)
  print("{first} {debug(xs)}")
}

