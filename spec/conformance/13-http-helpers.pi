//# case: script-mode
//# expect: run
//# stdout: 1 4 9
//# stdout: total 14
fn square(x: Int) -> Int { x * x }

var total = 0
let (a, b) = (2, 3)
let parts = MutList<Str>()
for i in 1..=b {
  parts.push("{square(i)}")
  total += square(i)
}
print(parts.join(" "))
print("total {total + a - 2}")

