// 규칙: DESIGN.md 3.4.1(컬렉션 보조 메서드), 3.20(스크립트 모드), 3.21(std/http)

//# case: http-routing
//# expect: tests
//# test: routes -> passed
//# test: listen-in-test -> aborted R0109
import std/http

data Book {
  pub id: Int
  pub title: Str
}

data NewBook {
  pub title: Str
}

class Shelf {
  mut books: MutMap<Int, Book> = MutMap<Int, Book>()
  pub mut fn add(title: Str) -> Book {
    let b = Book(id: self.books.len() + 1, title: title)
    self.books.set(b.id, b)
    b
  }
  pub fn get(id: Int) -> Book? { self.books.get(id) }
}

fn routes(shelf: Shelf) -> http.App {
  let app = http.App()
  app.get("/books/new", req => http.text("form"))
  app.get("/books/:id", req => {
    let id = Int.parse(req.params.get_or("id", "")).ok() else { return http.error(400, "bad id") }
    let b = shelf.get(id) else { return http.error(404, "no book {id}") }
    http.json(b)
  })
  app.post("/books", req => {
    let nb = req.json<NewBook>().ok() else { return http.error(400, "bad json") }
    http.json(shelf.add(nb.title), status: 201)
  })
  app.delete("/books/:id", req => http.empty(204))
  app.get("/search", req => http.text("q={req.query.get_or("q", "")} ua={req.headers.get_or("user-agent", "")}"))
  app
}

test "routes" {
  let app = routes(Shelf())
  let created = app.handle(http.request("POST", "/books", body: "\{\"title\":\"Dune\"\}"))
  assert created.status == 201
  assert created.headers.get("content-type") == Some("application/json")
  let b = app.handle(http.request("GET", "/books/1")).json<Book>()
  assert b == Ok(Book(id: 1, title: "Dune"))
  assert app.handle(http.request("GET", "/books/new")).body == "form"
  assert app.handle(http.request("GET", "/books/x")).status == 400
  assert app.handle(http.request("GET", "/books/7")).body == "\{\"error\":\"no book 7\"\}"
  assert app.handle(http.request("POST", "/books", body: "nope")).status == 400
  assert app.handle(http.request("DELETE", "/books/1")).status == 204
  let missing = app.handle(http.request("GET", "/authors"))
  assert missing.status == 404
  assert missing.body == "\{\"error\":\"not found\"\}"
  let wrong = app.handle(http.request("PUT", "/books/1"))
  assert wrong.status == 405
  assert wrong.body == "\{\"error\":\"method not allowed\"\}"
  let s = app.handle(http.request("GET", "/search?q=a%20b", headers: {"User-Agent": "t"}))
  assert s.body == "q=a b ua=t"
}

test "listen-in-test" {
  routes(Shelf()).listen(8080)
}

