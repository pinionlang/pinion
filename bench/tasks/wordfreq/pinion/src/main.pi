let SYL = ["ka", "lo", "mi", "nu", "pe", "ra", "si", "to", "ve", "wa", "xi", "yo", "ze", "bu", "da", "fo"]

data Entry {
  pub word: Str
  pub count: Int
}

fn main() !io {
  // Deterministic text: 300000 two-syllable words from a MINSTD generator.
  var x = 42
  let parts = MutList<Str>()
  for i in 0..300000 {
    x = x * 48271 % 2147483647
    parts.push(SYL[x % 16] + SYL[x / 16 % 16])
  }
  let text = parts.freeze().join(" ")

  let counts = MutMap<Str, Int>()
  for w in text.words() {
    counts.set(w, (counts.get(w) ?? 0) + 1)
  }
  let entries = MutList<Entry>()
  for (w, c) in counts {
    entries.push(Entry(word: w, count: c))
  }
  let ranked = entries.freeze().sort_by(e => (0 - e.count, e.word))
  print("distinct = {ranked.len()}")
  for e in ranked.slice(0, 10) {
    print("{e.word} {e.count}")
  }
}
