let SYL = ["ka", "lo", "mi", "nu", "pe", "ra", "si", "to", "ve", "wa", "xi", "yo", "ze", "bu", "da", "fo"]

// Deterministic text: 300000 two-syllable words from a MINSTD generator.
var x = 42
let words = MutList<Str>()
for i in 0..300000 {
  x = x * 48271 % 2147483647
  words.push(SYL[x % 16] + SYL[x / 16 % 16])
}
let counts = words.count_by(w => w)
print("distinct = {counts.len()}")
for w in counts.keys().sort_by(w => (-counts.get_or(w, 0), w)).take(10) {
  print("{w} {counts.get_or(w, 0)}")
}
