data Rec {
  pub key: Int
  pub id: Int
}

fn checksum(xs: List<Int>) -> Int {
  xs.fold(0, (h, v) => (h * 31 + v) % 1000000007)
}

var x = 12345
let nums = MutList<Int>()
let recs = MutList<Rec>()
for i in 0..200000 {
  x = x * 48271 % 2147483647
  nums.push(x % 1000000)
  recs.push(Rec(key: x % 1000, id: i))
}
let sorted = nums.freeze().sort()
print("ints: min = {sorted[0]} max = {sorted[sorted.len() - 1]} checksum = {checksum(sorted)}")
// sort_by is stable: equal keys keep their original (id) order.
let by_key = recs.freeze().sort_by(r => r.key)
print("recs: checksum = {checksum(by_key.map(r => r.id))}")
