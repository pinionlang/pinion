import std/http
import std/json
import std/env

data Book {
  pub id: Int
  pub title: Str
  pub author: Str
  pub year: Int
  pub tags: List<Str>
}

fn digits(s: Str) -> Int? {
  if s.is_empty() { return None }
  if !s.chars().all(c => "0123456789".contains(c)) { return None }
  Int.parse(s).ok()
}

fn title_ok(s: Str) -> Result<Str, Str> {
  let t = s.trim()
  if t.is_empty() || t.chars().len() > 200 { return Err("title: invalid") }
  Ok(t)
}

fn author_ok(s: Str) -> Result<Str, Str> {
  let t = s.trim()
  if t.is_empty() { return Err("author: invalid") }
  Ok(t)
}

fn keys() -> List<Str> { ["title", "author", "year", "tags"] }

fn app() -> http.App {
  let books = MutMap<Int, Book>()
  let next = MutList<Int>()
  let a = http.App()
  a.get("/books", req => {
    let off = match req.query.get("offset") { Some(s) => digits(s) ?? -1, None => 0 }
    let lim = match req.query.get("limit") { Some(s) => digits(s) ?? -1, None => -2 }
    if off == -1 || lim == -1 { return http.error(400, "bad query") }
    let au = req.query.get("author")
    let tg = req.query.get("tag")
    let xs = books.values().filter(b => (au.map(x => b.author == x) ?? true) && (tg.map(x => b.tags.contains(x)) ?? true)).drop(off)
    http.json(if lim == -2 { xs } else { xs.take(lim) })
  })
  a.post("/books", req => {
    let b = req.json_obj()?
    b.only(keys())?
    let bk = Book(id: 0, title: title_ok(b.req_str("title")?)?, author: author_ok(b.req_str("author")?)?, year: b.req_int("year", min: 0, max: 2100)?, tags: b.str_list("tags")? ?? [])
    next.push(next.len() + 1)
    let id = next.len()
    let r = bk.with(id: id)
    books.set(id, r)
    Ok(http.json(r, status: 201))
  })
  a.get("/books/:id", req => {
    let bk = books.get(digits(req.params.get_or("id", "")) ?? -1) else { return http.error(404, "not found") }
    http.json(bk)
  })
  a.put("/books/:id", req => {
    let bk = books.get(digits(req.params.get_or("id", "")) ?? -1) else { return Ok(http.error(404, "not found")) }
    let b = req.json_obj()?
    b.only(keys())?
    let r = bk.with(title: title_ok(b.req_str("title")?)?, author: author_ok(b.req_str("author")?)?, year: b.req_int("year", min: 0, max: 2100)?, tags: b.str_list("tags")? ?? [])
    books.set(r.id, r)
    Ok(http.json(r))
  })
  a.patch("/books/:id", req => {
    let bk = books.get(digits(req.params.get_or("id", "")) ?? -1) else { return Ok(http.error(404, "not found")) }
    let b = req.json_obj()?
    b.only(keys())?
    let t = match b.opt_str("title")? { Some(s) => title_ok(s)?, None => bk.title }
    let au = match b.opt_str("author")? { Some(s) => author_ok(s)?, None => bk.author }
    let r = bk.with(title: t, author: au, year: b.opt_int("year", min: 0, max: 2100)? ?? bk.year, tags: b.str_list("tags")? ?? bk.tags)
    books.set(r.id, r)
    Ok(http.json(r))
  })
  a.delete("/books/:id", req => {
    let _ = books.remove(digits(req.params.get_or("id", "")) ?? -1) else { return http.error(404, "not found") }
    http.empty(204)
  })
  a.get("/stats", req => {
    let byau = MutMap<Str, Int>()
    let tc = MutMap<Str, Int>()
    for b in books.values() {
      byau.inc(b.author)
      for t in b.tags.distinct() { tc.inc(t) }
    }
    let top = tc.entries().sort_by(e => { let (k, v) = e
      (0 - v, k) }).take(3).map(e => { let (k, v) = e
      [json.Json.Str(k), json.Json.Int(v)] })
    let m = MutMap<Str, json.Json>()
    m.set("count", json.Json.Int(books.len()))
    m.set("by_author", json.Json.Obj(byau.freeze().map_values(v => json.Json.Int(v))))
    m.set("top_tags", json.Json.Arr(top.map(p => json.Json.Arr(p))))
    http.json(json.Json.Obj(m.freeze()))
  })
  a
}

fn main() !net !env {
  app().listen(Int.parse(env.get("PORT") ?? "8080").unwrap_or(8080))
}
