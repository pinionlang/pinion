import std/http
import std/json
import std/env

enum J {
  JNull
  JBool(b: Bool)
  JNum(raw: Str)
  JStr(s: Str)
  JArr(items: List<J>)
  JObj(keys: List<Str>, vals: List<J>)
}

class Parser {
  cs: List<Str>
  mut pos: Int = 0

  fn peek() -> Str { self.cs.get(self.pos) ?? "" }

  mut fn ws() {
    while self.pos < self.cs.len() {
      let c = self.cs[self.pos]
      if c == " " || c == "\t" || c == "\n" || c == "\r" {
        self.pos = self.pos + 1
      } else {
        return
      }
    }
  }

  mut fn lit(w: Str) -> Bool {
    let n = w.len()
    if self.pos + n > self.cs.len() { return false }
    if self.cs.slice(self.pos, self.pos + n).join("") != w { return false }
    self.pos = self.pos + n
    true
  }

  mut fn digits() -> Int {
    var n = 0
    while "0123456789".contains(self.peek()) && self.peek() != "" {
      self.pos = self.pos + 1
      n += 1
    }
    n
  }

  mut fn value(depth: Int) -> J? {
    if depth > 200 { return None }
    self.ws()
    let c = self.peek()
    if c == "\{" {
      self.pos = self.pos + 1
      let ks = MutList<Str>()
      let vs = MutList<J>()
      self.ws()
      if self.peek() == "\}" {
        self.pos = self.pos + 1
        return Some(J.JObj(keys: ks.freeze(), vals: vs.freeze()))
      }
      while true {
        self.ws()
        if self.peek() != "\"" { return None }
        let k = self.string() else return None
        self.ws()
        if self.peek() != ":" { return None }
        self.pos = self.pos + 1
        let v = self.value(depth + 1) else return None
        ks.push(k)
        vs.push(v)
        self.ws()
        let d = self.peek()
        self.pos = self.pos + 1
        if d == "\}" { return Some(J.JObj(keys: ks.freeze(), vals: vs.freeze())) }
        if d != "," { return None }
      }
      return None
    }
    if c == "[" {
      self.pos = self.pos + 1
      let xs = MutList<J>()
      self.ws()
      if self.peek() == "]" {
        self.pos = self.pos + 1
        return Some(J.JArr(items: xs.freeze()))
      }
      while true {
        let v = self.value(depth + 1) else return None
        xs.push(v)
        self.ws()
        let d = self.peek()
        self.pos = self.pos + 1
        if d == "]" { return Some(J.JArr(items: xs.freeze())) }
        if d != "," { return None }
      }
      return None
    }
    if c == "\"" {
      let s = self.string() else return None
      return Some(J.JStr(s: s))
    }
    if self.lit("true") { return Some(J.JBool(b: true)) }
    if self.lit("false") { return Some(J.JBool(b: false)) }
    if self.lit("null") { return Some(J.JNull) }
    let start = self.pos
    if self.peek() == "-" { self.pos = self.pos + 1 }
    if self.peek() == "0" {
      self.pos = self.pos + 1
    } else {
      if self.digits() == 0 { return None }
    }
    if self.peek() == "." {
      self.pos = self.pos + 1
      if self.digits() == 0 { return None }
    }
    if self.peek() == "e" || self.peek() == "E" {
      self.pos = self.pos + 1
      if self.peek() == "+" || self.peek() == "-" { self.pos = self.pos + 1 }
      if self.digits() == 0 { return None }
    }
    Some(J.JNum(raw: self.cs.slice(start, self.pos).join("")))
  }

  mut fn hex4() -> Int? {
    if self.pos + 4 > self.cs.len() { return None }
    var n = 0
    for i in 0..4 {
      let h = "0123456789abcdef".index_of(self.cs[self.pos + i].lower()) else return None
      if self.cs[self.pos + i] == "" { return None }
      n = n * 16 + h
    }
    self.pos = self.pos + 4
    Some(n)
  }

  mut fn string() -> Str? {
    self.pos = self.pos + 1
    let out = MutList<Str>()
    while true {
      let c = self.cs.get(self.pos) else return None
      self.pos = self.pos + 1
      if c == "\"" { return Some(out.join("")) }
      if c == "\\" {
        let e = self.cs.get(self.pos) else return None
        self.pos = self.pos + 1
        if e == "\"" { out.push("\"") }
        else if e == "\\" { out.push("\\") }
        else if e == "/" { out.push("/") }
        else if e == "b" { out.push(json_unq("\\b")) }
        else if e == "f" { out.push(json_unq("\\f")) }
        else if e == "n" { out.push("\n") }
        else if e == "r" { out.push("\r") }
        else if e == "t" { out.push("\t") }
        else if e == "u" {
          var cp = self.hex4() else return None
          if cp >= 55296 && cp < 56320 {
            if !self.lit("\\u") { return None }
            let lo = self.hex4() else return None
            if lo < 56320 || lo >= 57344 { return None }
            cp = 65536 + (cp - 55296) * 1024 + (lo - 56320)
          } else if cp >= 56320 && cp < 57344 {
            return None
          }
          out.push(from_cp(cp))
        } else {
          return None
        }
      } else {
        let b = c.to_bytes()
        if b.len() == 1 && b[0] < 32 { return None }
        out.push(c)
      }
    }
    None
  }
}

fn json_unq(esc: Str) -> Str {
  json.decode<Str>("\"" + esc + "\"").ok() ?? ""
}

fn from_cp(cp: Int) -> Str {
  let bs = if cp < 128 {
    [cp]
  } else if cp < 2048 {
    [192 + cp / 64, 128 + cp % 64]
  } else if cp < 65536 {
    [224 + cp / 4096, 128 + (cp / 64) % 64, 128 + cp % 64]
  } else {
    [240 + cp / 262144, 128 + (cp / 4096) % 64, 128 + (cp / 64) % 64, 128 + cp % 64]
  }
  Bytes.from_list(bs).to_str().ok() ?? ""
}

fn parse(text: Str) -> J? {
  let p = Parser(cs: text.chars())
  let v = p.value(0) else return None
  p.ws()
  if p.pos != p.cs.len() { return None }
  Some(v)
}

data Book {
  pub id: Int
  pub title: Str
  pub author: Str
  pub year: Int
  pub tags: List<Str>
}

data Patch {
  pub title: Str?
  pub author: Str?
  pub year: Int?
  pub tags: List<Str>?
}

fn get_str(v: J) -> Str? {
  match v {
    JStr(s) => Some(s)
    JNull | JBool(_) | JNum(_) | JArr(_) | JObj(_, _) => None
  }
}

fn field(key: Str, v: J) -> Result<Patch, Str> {
  let empty = Patch(title: None, author: None, year: None, tags: None)
  if key == "title" {
    let s = get_str(v) else return Err("title must be a string")
    let t = s.trim()
    if t.is_empty() || t.len() > 200 { return Err("invalid title") }
    return Ok(empty.with(title: Some(t)))
  }
  if key == "author" {
    let s = get_str(v) else return Err("author must be a string")
    let t = s.trim()
    if t.is_empty() { return Err("invalid author") }
    return Ok(empty.with(author: Some(t)))
  }
  if key == "year" {
    let raw = match v {
      JNum(r) => r
      JNull | JBool(_) | JStr(_) | JArr(_) | JObj(_, _) => ""
    }
    if raw.is_empty() || raw.contains(".") || raw.contains("e") || raw.contains("E") { return Err("year must be an integer") }
    let y = Int.parse(raw).ok() else return Err("invalid year")
    if y < 0 || y > 2100 { return Err("year out of range") }
    return Ok(empty.with(year: Some(y)))
  }
  if key == "tags" {
    let items = match v {
      JArr(items) => Some(items)
      JNull | JBool(_) | JStr(_) | JNum(_) | JObj(_, _) => None
    }
    let xs = items else return Err("tags must be an array")
    let out = MutList<Str>()
    for x in xs {
      let s = get_str(x) else return Err("tags must be strings")
      out.push(s)
    }
    return Ok(empty.with(tags: Some(out.freeze())))
  }
  Err("unknown field {key}")
}

fn parse_patch(body: Str) -> Result<Patch, Str> {
  let v = parse(body) else return Err("invalid json")
  let (keys, vals) = match v {
    JObj(keys, vals) => (keys, vals)
    JNull | JBool(_) | JStr(_) | JNum(_) | JArr(_) => return Err("body must be an object")
  }
  var p = Patch(title: None, author: None, year: None, tags: None)
  for (i, k) in keys.enumerate() {
    let f = field(k, vals[i])?
    if f.title.is_some() { p = p.with(title: f.title) }
    if f.author.is_some() { p = p.with(author: f.author) }
    if f.year.is_some() { p = p.with(year: f.year) }
    if f.tags.is_some() { p = p.with(tags: f.tags) }
  }
  Ok(p)
}

fn full(id: Int, p: Patch) -> Result<Book, Str> {
  let t = p.title else return Err("title required")
  let a = p.author else return Err("author required")
  let y = p.year else return Err("year required")
  Ok(Book(id: id, title: t, author: a, year: y, tags: p.tags ?? []))
}

class Store {
  pub mut books: MutMap<Int, Book> = MutMap<Int, Book>()
  pub mut next: Int = 1

  pub mut fn add(p: Patch) -> Result<Book, Str> {
    let b = full(self.next, p)?
    self.next = self.next + 1
    self.books.set(b.id, b)
    Ok(b)
  }
  pub mut fn put(b: Book) { self.books.set(b.id, b) }
  pub mut fn del(id: Int) -> Bool { self.books.remove(id).is_some() }
  pub fn get(id: Int) -> Book? { self.books.get(id) }
  pub fn all() -> List<Book> { self.books.values().sort_by(b => b.id) }
}

fn raw_json(body: Str, status: Int) -> http.Response {
  http.Response(status: status, body: body, headers: {"content-type": "application/json"})
}

fn nat(s: Str) -> Int? {
  if s.is_empty() { return None }
  if !s.chars().all(c => "0123456789".contains(c)) { return None }
  Int.parse(s).ok()
}

fn book_id(req: http.Request) -> Int? {
  let s = req.params.get_or("id", "")
  nat(s)
}

fn not_found() -> http.Response { http.error(404, "not found") }

fn routes(store: Store) -> http.App {
  let app = http.App()
  app.post("/books", req => {
    if req.path != "/books" { return not_found() }
    match parse_patch(req.body) {
      Ok(p) => match store.add(p) {
        Ok(b) => http.json(b, status: 201)
        Err(m) => http.error(400, m)
      }
      Err(m) => http.error(400, m)
    }
  })
  app.get("/books", req => {
    if req.path != "/books" { return not_found() }
    let q = req.query
    var off = 0
    if q.contains_key("offset") {
      let o = nat(q.get_or("offset", "")) else { return http.error(400, "invalid offset") }
      off = o
    }
    var lim = -1
    if q.contains_key("limit") {
      let l = nat(q.get_or("limit", "")) else { return http.error(400, "invalid limit") }
      lim = l
    }
    var xs = store.all()
    if q.contains_key("author") {
      let a = q.get_or("author", "")
      xs = xs.filter(b => b.author == a)
    }
    if q.contains_key("tag") {
      let t = q.get_or("tag", "")
      xs = xs.filter(b => b.tags.contains(t))
    }
    xs = if off >= xs.len() { [] } else { xs.drop(off) }
    if lim >= 0 && lim < xs.len() { xs = xs.take(lim) }
    http.json(xs)
  })
  app.get("/books/:id", req => {
    let id = book_id(req) else { return not_found() }
    let b = store.get(id) else { return not_found() }
    http.json(b)
  })
  app.put("/books/:id", req => {
    let id = book_id(req) else { return not_found() }
    if store.get(id).is_none() { return not_found() }
    let p = match parse_patch(req.body) {
      Ok(p) => p
      Err(m) => return http.error(400, m)
    }
    match full(id, p) {
      Ok(b) => {
        store.put(b)
        http.json(b)
      }
      Err(m) => http.error(400, m)
    }
  })
  app.patch("/books/:id", req => {
    let id = book_id(req) else { return not_found() }
    let old = store.get(id) else { return not_found() }
    let p = match parse_patch(req.body) {
      Ok(p) => p
      Err(m) => return http.error(400, m)
    }
    let b = old.with(title: p.title ?? old.title, author: p.author ?? old.author, year: p.year ?? old.year, tags: p.tags ?? old.tags)
    store.put(b)
    http.json(b)
  })
  app.delete("/books/:id", req => {
    let id = book_id(req) else { return not_found() }
    if !store.del(id) { return not_found() }
    http.empty(204)
  })
  app.get("/stats", req => {
    if req.path != "/stats" { return not_found() }
    let xs = store.all()
    let by = xs.count_by(b => b.author)
    let tc = MutMap<Str, Int>()
    for b in xs {
      for t in b.tags.distinct() { tc.inc(t) }
    }
    let top = tc.freeze().keys().sort_by(t => (-tc.get_or(t, 0), t)).take(3)
    let pairs = top.map(t => "[{json.encode(t)},{tc.get_or(t, 0)}]").join(",")
    raw_json("\{\"count\":{xs.len()},\"by_author\":{json.encode(by)},\"top_tags\":[{pairs}]\}", 200)
  })
  app
}

fn main() !net !env {
  let port = Int.parse(env.get("PORT") ?? "8080").ok() ?? 8080
  routes(Store()).listen(port)
}
